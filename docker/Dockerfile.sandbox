FROM mcr.microsoft.com/playwright:v1.55.0-noble

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv git \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install playwright pytest pytest-playwright --break-system-packages

# Baked playwright-core for the agent-capture browser driver (cua/pipeline/instrumentation/browser_driver.js).
# Pinned to the image's Playwright revision so the bundled /ms-playwright browsers match; the
# driver also falls back to a runtime npm install when this directory is absent (older images).
RUN mkdir -p /opt/driver && cd /opt/driver && npm init -y >/dev/null \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install playwright-core@1.55.0 --no-audit --no-fund

WORKDIR /workspace

# Container runs as non-root user "pwuser" from the base image
